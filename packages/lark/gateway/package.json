{
  "name": "dsh-lark-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "网关宿主面核心：授权、去重、Scope 引导、会话协调、运行事件流→卡片编排、审批呈现与回调解答",
  "exports": {
    "./bot-fleet": { "types": "./lib/types/bot-fleet.d.ts", "default": "./lib/bot-fleet.js" },
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./lib/types/index.d.ts",
  "main": "./lib/index.js",
  "files": ["lib"],
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "dsh-cdg-bridge": "workspace:*",
    "dsh-lark": "workspace:*",
    "dsh-lark-card": "workspace:*",
    "dsh-lark-commands": "workspace:*",
    "dsh-lark-contracts": "workspace:*",
    "dsh-lark-run-client": "workspace:*",
    "dsh-lark-ws": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-credentials": "0.1.5-rc.1",
    "@deepseek-ai/dsh-session": "0.1.5-rc.1"
  }
}
