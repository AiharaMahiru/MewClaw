{
  "name": "dsh-lark-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsc -b && node scripts/build-web-auth-client.mjs",
    "clean": "tsc -b --clean",
    "postinstall": "tsc -b packages/lark/atw-brand && node scripts/verify-dsh-brand.mjs",
    "verify:dsh-brand": "node scripts/verify-dsh-brand.mjs",
    "verify:official-integrity": "node scripts/verify-official-integrity.mjs",
    "dev:gateway": "node --import tsx/esm apps/lark-gateway/src/main.ts",
    "dev:worker": "node --import tsx/esm apps/lark-worker/src/main.ts",
    "dev:admin": "node --import tsx/esm apps/admin/src/main.ts",
    "dev:auth": "node --import tsx/esm apps/auth/src/main.ts",
    "dev:preview": "node --import tsx/esm apps/preview/src/main.ts",
    "dev:migration": "node --env-file-if-exists=.env --import tsx/esm apps/migration/src/main.ts",
    "dev:admin-web": "pnpm --filter dsh-lark-admin-web dev",
    "dev:dsh-web": "node --import tsx/esm apps/lark-worker/src/main.ts",
    "build:admin-web": "pnpm --filter dsh-lark-admin-web build",
    "smoke": "node scripts/validate-linux-release.mjs",
    "smoke:auth": "node --env-file-if-exists=.env --import tsx/esm apps/auth/src/main.ts --boot-check",
    "smoke:base": "node --expose-internals --import tsx/esm tests/smoke/base.ts",
    "smoke:migration": "node --env-file-if-exists=.env --import tsx/esm apps/migration/src/main.ts --boot-check --tenant-id boot-check --bot-id boot-check --deployment-id dooragent-rehearsal --user-id boot-check-admin --conversation-id boot-check --operator-session-id boot-check --request-id boot-check",
    "postgres:install": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js install",
    "postgres:setup": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js setup",
    "postgres:start": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js start",
    "postgres:status": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js status",
    "postgres:stop": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js stop",
    "postgres:web:install": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js web-install",
    "postgres:web:setup": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js web-setup",
    "postgres:web:start": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js web-start",
    "postgres:web:status": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js web-status",
    "postgres:web:stop": "tsc -b infra/postgres && node --env-file-if-exists=.env infra/postgres/dist/cli.js web-stop",
    "linux:build": "tsc -b infra/linux",
    "linux:test": "vitest run infra/linux/src",
    "service:build": "tsc -b infra/postgres infra/windows",
    "service:install": "npm run service:build && powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 install",
    "service:uninstall": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 uninstall",
    "service:start": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 start",
    "service:stop": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 stop",
    "service:restart": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 restart",
    "service:status": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 status",
    "service:logs": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File infra/windows/dsh-lark-service.ps1 logs",
    "sandbox:build": "node infra/sandbox/build.mjs",
    "sandbox:validate-image": "node infra/sandbox/validate-image.mjs",
    "lint": "eslint apps packages infra tests scripts/session-upgrade",
    "test": "vitest run",
    "test:external:knowledge": "vitest run --config vitest.external.config.ts",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "verify": "node scripts/verify.mjs"
  },
