[Unit]
Description=MewClaw Rootless Podman Initialization
After=user@995.service
Requires=user@995.service
Before=dsh-worker.service dsh-preview.service

[Service]
Type=oneshot
User=dsh
Group=dsh
Environment=HOME=/var/lib/dsh
Environment=XDG_RUNTIME_DIR=/run/user/995
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/995/bus
# 仅固定 Podman 初始化命令允许调用发行版 newuidmap/newgidmap；不接收模型输入。
ExecStart=/usr/bin/podman info --format={{.Host.Security.Rootless}}
RemainAfterExit=yes
TimeoutStartSec=30s
NoNewPrivileges=false
CapabilityBoundingSet=CAP_SETUID CAP_SETGID
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/dsh /run/user/995
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077

[Install]
WantedBy=multi-user.target
